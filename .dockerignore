# .dockerignore - Archivos y carpetas a excluir del build de Docker
# Versión: 1.3.0

# Entornos virtuales
venv/
env/
ENV/
.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebooks
*.ipynb
.ipynb_checkpoints/

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Documentación y archivos de desarrollo
README.md
*.md
docs/

# Archivos de configuración locales
.env
secrets.ini
*.ini

# Logs
*.log

# Sistema operativo
.DS_Store
Thumbs.db

# Docker
Dockerfile
.dockerignore

# Gráficos y reportes generados
*.png
*.jpg
*.jpeg
*.pdf

# Archivos temporales
*.tmp
*.bak
temp/
